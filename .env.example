# SSH port (avoid 22). Real value comes from the SSH_PORT GitHub secret,
# left blank here so it isn't public in a public repo.
SSH_PORT=

# Pi-hole web admin password (FTLCONF_webserver_api_password)
PIHOLE_WEBPASSWORD=

# CUPS print server admin password
CUPS_ADMIN_PASSWORD=

# LAN IP of this server (netplan, Pi-hole reply host, CUPS advertised address)
SERVER_IP=

# Timezone for all containers (e.g. America/Guatemala)
TZ=

# Cloudflare API token (Let's Encrypt DNS-01 wildcard cert via Traefik). Scoped
# to the BASE_DOMAIN zone: Zone:Zone:Read + Zone:DNS:Edit. See README TLS section.
CF_DNS_API_TOKEN=

# Full domain used for all internal hostnames AND the public Cloudflare Tunnel
# hostname (ha-remote.$BASE_DOMAIN) — must be a zone in the same Cloudflare
# account as CF_DNS_API_TOKEN / CLOUDFLARE_TUNNEL_TOKEN below.
BASE_DOMAIN=

# Email for Let's Encrypt expiry notices
ACME_EMAIL=

# Fixed API keys for Sonarr/Radarr
SONARR_API_KEY=
RADARR_API_KEY=

# Home Assistant: ubicacion de casa. Se renderiza en docker/home-assistant/
HA_LATITUDE=
HA_LONGITUDE=
HA_ELEVATION=

# Cloudflare Tunnel (exposes home-assistant publicly at ha-remote.$BASE_DOMAIN,
# for the Alexa Smart Home skill). Token from the tunnel created in the
# Cloudflare Zero Trust dashboard. See README "Acceso remoto" section.
CLOUDFLARE_TUNNEL_TOKEN=

# Alexa Smart Home skill (self-hosted, Proactive State Reporting). From
# Amazon Developer Console -> the skill -> Permissions -> "Send Alexa
# Events" (NOT the Account Linking client id/secret).
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
